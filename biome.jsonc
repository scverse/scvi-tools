{
    "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    // Markdown formatting (biome >= 2.6) mangles MyST math, e.g. `_` -> `*` inside `$...$`.
    "files": { "includes": ["**", "!**/*.md"] },
    "formatter": { "useEditorconfig": true },
    "overrides": [
        {
            "includes": ["./.vscode/*.json", "**/*.jsonc"],
            "json": {
                "formatter": { "trailingCommas": "all" },
                "parser": {
                    "allowComments": true,
                    "allowTrailingCommas": true,
                },
            },
        },
    ],
}
